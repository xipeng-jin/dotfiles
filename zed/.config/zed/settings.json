// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "ssh_connections": [
    {
      "host": "home-dev-server",
      "username": "xjin",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/xjin/Program/dev/googoo/./"
          ]
        },
        {
          "paths": [
            "/home/xjin/Program/dev/xpcode/./"
          ]
        }
      ]
    }
  ],
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "auto_signature_help": true,
  "autoscroll_on_clicks": false,
  "sticky_scroll": {
    "enabled": true,
  },
  "diff_view_style": "unified",
  "excerpt_context_lines": 3,
  "which_key": {
    "enabled": true,
  },
  "buffer_font_weight": 400.0,
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "opencode": {
      "type": "registry",
    },
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true,
  },
  "agent": {
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "enable_thinking": false,
      "provider": "zed.dev",
      "model": "claude-opus-4-6",
    },
    "play_sound_when_agent_done": true,
  },
  "show_edit_predictions": false,
  "edit_predictions": {
    "mode": "subtle",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
      "enterprise_uri": null,
    },
    "enabled_in_text_threads": false,
  },
  "icon_theme": "Zed (Default)",
  "base_keymap": "VSCode",
  "vim_mode": true,
  "ui_font_size": 13.5,
  "buffer_font_size": 12.5,
  "buffer_line_height": {
    "custom": 1.4,
  },
  "terminal": {
    "font_size": 12,
    "line_height": { "custom": 1.3 },
  },
  "relative_line_numbers": "wrapped",
  "git": {
    "inline_blame": {
      "enabled": false,
    },
    "hunk_style": "staged_hollow",
  },
  "inlay_hints": {
    "enabled": true,
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "format_on_save": "on",
}
