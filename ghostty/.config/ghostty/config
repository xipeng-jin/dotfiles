# Dynamic theme colors
config-file = ?"~/.config/omarchy/current/theme/ghostty.conf"

# Font
font-family = "JetBrainsMono Nerd Font"
font-style = Regular
font-size = 9

# Window
window-theme = ghostty
window-padding-x = 10
window-padding-y = 8
confirm-close-surface=false
resize-overlay = never
gtk-toolbar-style = flat

# Cursor styling
cursor-style-blink = false
cursor-style = "block"

# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together)
shell-integration-features = no-cursor,ssh-env

# Notificaiton
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify

# Keyboard bindings
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
keybind = super+control+shift+arrow_up=resize_split:up,100
keybind = super+control+shift+arrow_down=resize_split:down,100
keybind = super+control+shift+arrow_left=resize_split:left,100
keybind = super+control+shift+arrow_right=resize_split:right,100

keybind = control+alt+w=close_surface

keybind = control+alt+l=goto_split:right
keybind = control+alt+h=goto_split:left
keybind = control+alt+j=goto_split:down
keybind = control+alt+k=goto_split:up

keybind = control+shift+l=next_tab
keybind = control+shift+h=previous_tab

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll
